<!-- Auto removes the base app's Leanback launcher and is entered through Android Auto;
     it deliberately has no Android TV launcher activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
	tools:ignore="MissingLeanbackSupport">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- xFermaTube (YouTube only): DISABLE_KEYGUARD, RECEIVE_BOOT_COMPLETED,
         FOREGROUND_SERVICE_MEDIA_PROJECTION, WRITE_SECURE_SETTINGS and MANAGE_EXTERNAL_STORAGE are
         not requested: mirror, car apps over ADB and local files are not reachable in this build. -->
    <!-- xFermaTube: "Fix install source" asks the phone's installer to install the app's own APK
         again. The phone's installer refuses a request from an app that does not declare this, and
         the user has to allow it for the app ("Install unknown apps"). Nothing else is installed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- xFermaTube: "Display over other apps", allowed by the user in the phone settings. While the
         car screen is on, a 1x1 invisible window that ignores touches keeps Samsung phones drawing
         the car screen when the phone app is in the background (XfKeepDrawing). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

	<!-- Auto can run on TV-style head units that do not expose a touchscreen. -->
	<uses-feature
		android:name="android.hardware.touchscreen"
		android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- xFermaTube: "Fix install source" has to find the phone's own package installer -->
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data
                android:mimeType="application/vnd.android.package-archive"
                android:scheme="content" />
        </intent>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
    </queries>


    <application
		android:banner="@drawable/banner"
		android:icon="@drawable/launcher">
		<activity
			android:name="me.aap.fermata.ui.activity.MainActivity"
			android:excludeFromRecents="false"
			android:exported="true">
			<intent-filter tools:node="remove">
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
			<intent-filter tools:node="remove">
				<action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>

		<activity
			android:name="me.app.fermatax.auto.PhoneLauncherActivity"
			android:excludeFromRecents="true"
			android:exported="true"
			android:launchMode="singleTop"
			android:noHistory="true"
			android:taskAffinity="me.app.fermatax.auto.launcher"
			android:theme="@android:style/Theme.NoDisplay">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
		</activity>

        <service
            android:name="me.aap.fermata.media.service.FermataMediaService"
			tools:node="remove" />

		<service
			android:name="me.app.fermatax.auto.AutoFermataMediaService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:icon="@drawable/media_service_icon"
			android:label="@string/media_service_name"
			tools:ignore="ExportedService">
			<intent-filter>
				<action android:name="android.media.browse.MediaBrowserService" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.MEDIA_BUTTON" />
			</intent-filter>
		</service>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Android Auto hooks" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="5"
            tools:ignore="MetadataTagInsideApplicationTag" />

        <service
            android:name="me.app.fermatax.auto.CarService"
            android:exported="true"
            android:icon="@drawable/launcher"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <service
            android:name="me.app.fermatax.auto.MirrorService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/mirror"
            android:label="@string/mirror_service_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

        <activity
            android:name="me.app.fermatax.auto.ProjectionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance" />

        <activity
            android:name="me.app.fermatax.auto.LauncherActivity"
            android:configChanges="colorMode|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance" />

        <activity
            android:name="me.app.fermatax.auto.carapps.PhoneDimActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name="me.app.fermatax.auto.carapps.adb.AdbSetupActivity"
            android:exported="false" />

        <receiver
            android:name="me.app.fermatax.auto.carapps.adb.AdbPairing$Receiver"
            android:exported="false" />

        <!-- xFermaTube: "Fix install source" (the phone's installer reinstalls the app "from Google Play") -->
        <activity
            android:name="me.app.fermatax.auto.xf.XfInstallFixActivity"
            android:exported="false" />

        <!-- Serves only the app's own APK, read-only, to the installer that was given a grant for it -->
        <provider
            android:name="me.app.fermatax.auto.xf.XfApkProvider"
            android:authorities="${applicationId}.xfapk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name="me.app.fermatax.auto.xf.XfInstallFixer$Receiver"
            android:exported="false" />

        <!-- Not exported: BOOT_COMPLETED and MY_PACKAGE_REPLACED come from the system, which may start a
             non-exported receiver of the app; nothing else can reach it. -->
        <receiver
            android:name="me.app.fermatax.auto.carapps.adb.AdbRecoveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name="me.app.fermatax.auto.carapps.adb.AdbRecoveryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name="me.app.fermatax.auto.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name="me.app.fermatax.auto.AccessibilityEventDispatcherService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <service
            android:name="me.app.fermatax.auto.XposedEventDispatcherService"
            android:exported="true"
            tools:ignore="ExportedService" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths"
                tools:replace="android:resource" />
        </provider>

        <provider
            android:name="me.app.fermatax.auto.carapps.ServerBinderProvider"
            android:authorities="${applicationId}.cardisplay"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

    </application>
</manifest>
